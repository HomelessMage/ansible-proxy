# {{ ansible_managed }}
{% if tls %}
upstream xray_xhttp {
    server 127.0.0.1:{{ xhttp_port }};
    keepalive 64;
}

{% endif %}
# HTTP: ACME webroot + редирект на HTTPS по имени
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ node_domain }};
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; default_type text/plain; }
    location / { return 301 https://{{ node_domain }}$request_uri; }
}
{% if tls %}

# Чужой SNI или голый IP: рвём handshake
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ node_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ node_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ node_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    absolute_redirect off;

    # VLESS + XHTTP (packet-up)
    location ^~ /{{ xhttp_path }}/ {
        proxy_pass http://xray_xhttp;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 0;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        access_log off;
    }

    location ~ /\. { deny all; }

    location / {
        root /var/www/site;
        try_files $uri $uri/ =404;
    }
}
{% endif %}
